[Unit]
Description=Sub2API Mihomo fixed egress service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__MIHOMO_USER__
Group=__MIHOMO_GROUP__
WorkingDirectory=__MIHOMO_ROOT__
ExecStart=__MIHOMO_ROOT__/bin/mihomo -d __MIHOMO_ROOT__ -f __MIHOMO_ROOT__/config.yaml
Restart=always
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__MIHOMO_ROOT__

[Install]
WantedBy=multi-user.target
