[Unit]
Description=Lightweight Mihomo for Server2 (Sub2API / Docker-friendly)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/sub2-mihomo
ExecStart=/opt/sub2-mihomo/bin/mihomo -d /opt/sub2-mihomo -f /opt/sub2-mihomo/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/sub2-mihomo

[Install]
WantedBy=multi-user.target
